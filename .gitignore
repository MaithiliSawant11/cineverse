# CINEVERSE – .gitignore

# ── Python backend ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
env/
venv/
.venv/
backend/.env
*.egg-info/
dist/
build/
.pytest_cache/

# ── Node / Frontend ────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.production

# ── OS ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── IMPORTANT: Keep the model files! ──────────────────────────────────
# DO NOT add backend/models/ here.
# similarity.pkl is large (176 MB) — use Git LFS (see .gitattributes).
